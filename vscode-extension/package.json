{
  "name": "lorem-ipsum-generator",
  "displayName": "Lorem Ipsum Generator",
  "description": "Insert pseudo-random placeholder text from a vowel/consonant word engine.",
  "version": "0.1.0",
  "publisher": "GilbertZennerDev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Snippets", "Other"],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "loremIpsum.insert",
        "title": "Lorem Ipsum: Insert Placeholder Text"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GilbertZennerDev/LoremIpsum"
  },
  "license": "MIT"
}
